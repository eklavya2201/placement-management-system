@using PlacementManagementSystem.Models
@using Microsoft.AspNetCore.Mvc.Rendering
@model JobDrive

@{
    ViewData["Title"] = "Add Job Drive";
}

<div class="page-head">
    <div>
        <a class="back" asp-action="Index">← Job Drives</a>
        <h1>Add Job Drive</h1>
    </div>
</div>

<form asp-action="Create" method="post" class="panel form-panel">
    <div asp-validation-summary="All" class="form-errors"></div>
    <div class="mb-3">
        <label class="form-label">Company</label>
        <select asp-for="CompanyId" class="form-select" asp-items="(SelectList)ViewBag.Companies" required>
            <option value="">Select a company</option>
        </select>
    </div>
    <div class="mb-3">
        <label class="form-label">Role</label>
        <input asp-for="Role" class="form-control" placeholder="e.g. Software Engineer" required />
    </div>
    <div class="row">
        <div class="col-sm-4 mb-3">
            <label class="form-label">Package (LPA)</label>
            <input asp-for="PackageLpa" class="form-control" type="number" step="0.1" min="0" required />
        </div>
        <div class="col-sm-4 mb-3">
            <label class="form-label">Minimum CGPA</label>
            <input asp-for="MinCgpa" class="form-control" type="number" step="0.01" min="0" max="10" required />
        </div>
        <div class="col-sm-4 mb-3">
            <label class="form-label">Drive date</label>
            <input asp-for="DriveDate" class="form-control" type="date" required />
        </div>
    </div>
    <div class="form-actions">
        <a asp-action="Index" class="btn btn-link">Cancel</a>
        <button type="submit" class="btn btn-primary">Save drive</button>
    </div>
</form>
