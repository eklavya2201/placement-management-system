@using PlacementManagementSystem.Data
@model List<JobDriveRow>

@{
    ViewData["Title"] = "Job Drives";
}

<div class="page-head">
    <div>
        <h1>Job Drives</h1>
        <p>@Model.Count hiring drives scheduled</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">+ Add Job Drive</a>
</div>

<div class="panel">
    <table class="table data-table mb-0">
        <thead>
            <tr><th>Company</th><th>Role</th><th>Package</th><th>Min CGPA</th><th>Drive Date</th></tr>
        </thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="5" class="empty">No job drives added yet.</td></tr>
            }
            @foreach (var j in Model)
            {
                <tr>
                    <td class="strong">@j.CompanyName</td>
                    <td>@j.Role</td>
                    <td class="package">₹@j.PackageLpa.ToString("0.#") LPA</td>
                    <td>@j.MinCgpa.ToString("0.00")</td>
                    <td class="muted">@j.DriveDate.ToString("dd MMM yyyy")</td>
                </tr>
            }
        </tbody>
    </table>
</div>
