@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Apply to Job Drive";
}

<div class="page-head">
    <div>
        <a class="back" asp-action="Index">← Applications</a>
        <h1>Apply Student to a Drive</h1>
        <p>The student's CGPA is checked against the drive's minimum before the application is saved.</p>
    </div>
</div>

<form asp-action="Apply" method="post" class="panel form-panel">
    <div asp-validation-summary="All" class="form-errors"></div>
    <div class="mb-3">
        <label class="form-label">Student</label>
        <select name="studentId" class="form-select" asp-items="(SelectList)ViewBag.Students" required>
            <option value="">Select a student</option>
        </select>
    </div>
    <div class="mb-3">
        <label class="form-label">Job drive</label>
        <select name="jobDriveId" class="form-select" asp-items="(SelectList)ViewBag.JobDrives" required>
            <option value="">Select a job drive</option>
        </select>
    </div>
    <div class="form-actions">
        <a asp-action="Index" class="btn btn-link">Cancel</a>
        <button type="submit" class="btn btn-primary">Submit application</button>
    </div>
</form>
